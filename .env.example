# Copy to .env per app, or set in your host's environment UI.

# ── apps/server (game server) ────────────────────────────────────────────────
# Postgres connection string. Works with Supabase:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# (Project settings → Database → Connection string → "Transaction" pooler.)
# Unset keeps everything in memory — fine for local play and tests.
DATABASE_URL=

# On Fly, set it as a secret (`fly secrets set DATABASE_URL=...`): auto-stop
# suspends the machine when idle, which wipes in-memory rooms.

# Port for the game server (default 8787; fly.toml/Dockerfile pin it anyway).
PORT=8787

# Chat moderation via the OpenAI v1 moderations API. Without a key, chat is
# unmoderated. `OPENAI_MODERATION=off` force-disables it even with a key.
# Put the real key in .env.local (gitignored) or a host secret.
OPENAI_API_KEY=
OPENAI_MODERATION=
# Optional: route moderations through a proxy or gateway (default: official API).
OPENAI_BASE_URL=

# ── apps/web (SvelteKit build, hosted e.g. on Netlify) ──────────────────────
# Absolute WS endpoint of the game server for the hosted frontend. Local dev
# leaves it unset and uses the vite /ws proxy → ws://localhost:8787.
VITE_GAME_WS_URL=
